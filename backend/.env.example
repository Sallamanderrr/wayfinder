# Required: used by the agents and for the RAG embeddings.
OPENAI_API_KEY=

# Optional (defaults shown). Models use LangChain's "provider:model" format.
LLM_MODEL=openai:gpt-4.1-mini
# Leave empty for reasoning models that only accept their default temperature.
LLM_TEMPERATURE=0.2
EMBEDDING_MODEL=openai:text-embedding-3-small

# Hard limits per user message: agent runs, and verifier reviews.
MAX_AGENT_RUNS=6
MAX_REVIEWS=2

CORS_ORIGINS=http://localhost:5173
